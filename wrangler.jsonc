
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kingsmade",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kingsmade-store",
      "database_id": "294851a1-7adf-48f0-a8a4-fce8b74ea7e9"
    }
  ]
}
