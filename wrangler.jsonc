{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kingsmade-admin-test",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/admin",
      "/admin/*",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_TEST_DATABASE_NAME",
      "database_id": "YOUR_SEPARATE_TEST_DATABASE_ID"
    }
  ]
}
